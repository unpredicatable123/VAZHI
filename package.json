{
	"name": "vazhi",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync && npm run paraglide",
		"check": "npm run paraglide && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "npm run paraglide && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --output-structure locale-modules",
		"functions:build": "npm --prefix functions run build",
		"firebase:seed": "tsx scripts/seed-firestore.js",
		"firebase:reconcile": "tsx scripts/reconcile-seats.js",
		"firebase:smoke": "tsx scripts/smoke-functions.js",
		"firebase:smoke:accounts": "tsx scripts/smoke-account-provisioning.js",
		"firebase:verify:email": "tsx scripts/verify-ticket-email.js",
		"firebase:ext": "firebase ext:install firebase/firestore-send-email",
		"firebase:emulators": "firebase emulators:start",
		"test": "npm run test:payani && npm run test:scan && npm run test:payment && npm run test:rate-limit && npm run test:geo-progress && npm run test:ledger && npm run test:demo-routes",
		"test:payani": "tsx tests/payani.test.js",
		"test:scan": "tsx tests/ticket-reference.test.js",
		"test:payment": "tsx tests/payment-signature.test.js",
		"test:rate-limit": "tsx tests/rate-limit.test.js",
		"test:geo-progress": "tsx tests/geo-progress.test.js",
		"test:ledger": "tsx tests/ledger-and-email.test.js",
		"test:demo-routes": "tsx tests/demo-routes.test.js",
		"test:rules": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-firestore-rules.ps1",
		"firebase:deploy": "npm run build && npm run functions:build && firebase deploy"
	},
	"devDependencies": {
		"@firebase/rules-unit-testing": "^5.0.0",
		"@inlang/paraglide-js": "^2.24.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.2.0",
		"@types/qrcode": "^1.5.6",
		"firebase-tools": "^15.28.1",
		"svelte": "^5.56.10",
		"svelte-check": "^4.4.1",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.20.0",
		"typescript": "^5.9.3",
		"vite": "^7.1.14"
	},
	"dependencies": {
		"firebase": "^12.18.0",
		"jsqr": "^1.4.0",
		"maplibre-gl": "^6.6.0",
		"ogl": "^1.0.11",
		"qrcode": "^1.5.4"
	}
}
