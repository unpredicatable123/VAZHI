VITE_MAPTILER_KEY=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
# Optional; defaults to asia-south1.
VITE_FIREBASE_FUNCTIONS_REGION=asia-south1

# Razorpay publishable key id (rzp_test_… or rzp_live_…).
# The matching SECRET is never a VITE_ variable and never lives in this repo:
#   npx firebase functions:secrets:set RAZORPAY_KEY_SECRET
VITE_RAZORPAY_KEY_ID=
