{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"outputDirectory": "build",
	"cleanUrls": true,
	"rewrites": [{ "source": "/(.*)", "destination": "/200.html" }],
	"headers": [
		{
			"source": "/_app/immutable/(.*)",
			"headers": [
				{ "key": "Cache-Control", "value": "public,max-age=31536000,immutable" }
			]
		}
	]
}
